# Git ignore for HCMC AI Challenge 2026 Workspace

# Exclude global weights and dataset directories at root level
/weights/
/datasets/
.download_assets_deps/

# Exclude python environments
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Exclude credentials and environment files
.env

# Exclude runtime temporary files
temp/
*.log
*.wav
*.mp4

# Interaction logs (webapp/backend/interaction_log.py) - local JSONL
# fallback so nothing is lost if DRES's log endpoint is down, but not
# meant to be committed to the repo.
webapp/backend/logs/

# Exclude model weight/checkpoint files
*.pt
/preprocessing/mobileclip2_b.ts

# Exclude database storage directory (Qdrant)
/preprocessing/qdrant_storage/
/preprocessing/qdrant_bin/
/preprocessing/.qdrant-initialized

# OS files
.DS_Store
Thumbs.db

# ffmpeg
ffmpeg

# Evaluation benchmark output reports
eval_results.json
evaluation/eval_results.json
evaluation/eval_audit_results.json
evaluation/v3c_eval_results.json
evaluation/benchmark_real_output/
evaluation/indexing_logs/
queries/v3c_audit_output/
queries/weMM_audit_output/
queries/ablation_*/
queries/submission/
queries/submission.zip
queries/*.jsonl
# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
*.nav
*.snm
*.toc
paper/live_server.py
paper/start_server.sh
paper/compile.sh
paper/index.html
paper/comments.json


# Local runner scripts
run_wemm_full_indexing.py
monitor_and_eval_on_finish.sh
# Private files
VBS-2026-978-981-95-6963-2.pdf

# AI assistant, agent skills, and planning directories
.claude/
.agents/skills/
/plans/
plans/
