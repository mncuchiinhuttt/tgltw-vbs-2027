# OpenAI-compatible API config. Leave OPENAI_BASE_URL blank to use OpenAI
# directly, or point it at any OpenAI-compatible vision-capable provider
# (e.g. QwenCloud's DashScope endpoint, or GPT-5.6-Luna) with a matching
# OPENAI_VLM_MODEL_NAME. Fill in OPENAI_BASE_URL with the provider's
# OpenAI-compatible endpoint - models/openai_vlm.py sends images as
# chat.completions image_url content blocks, so the provider must support
# vision input, not just text.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VLM_MODEL_NAME=gpt-5.6-luna

# Model selection options
# VLM_OPTION: "local" or "openai"
VLM_OPTION=openai
# EMBEDDING_OPTION: "local" (QwenVL8BEmbedder, ~15GB) or "cloud"
# (DashScopeCloudEmbedder via OPENAI_API_KEY/OPENAI_BASE_URL, no local weights)
EMBEDDING_OPTION=local

# Model checkpoints
QWEN_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
# 2B by default (fits resource-constrained hardware); override to
# Qwen/Qwen3-VL-Embedding-8B for slightly higher accuracy if VRAM allows
QWEN_EMBEDDING_MODEL_ID=Qwen/Qwen3-VL-Embedding-2B
# Optional: truncate embeddings to this many leading dims (MRL, e.g. 512) for
# a smaller/faster Qdrant index. Leave blank to keep the full dimension.
EMBEDDING_MRL_DIM=
# ASR (faster-whisper/CTranslate2, Whisper large-v3-turbo, 99-language, MIT)
ASR_MODEL_ID=deepdml/faster-whisper-large-v3-turbo-ct2
# Blank = auto-detect language per file. Set e.g. "en" to force.
ASR_LANGUAGE=
ASR_COMPUTE_TYPE=auto
ASR_VAD_FILTER_ENABLED=true
ASR_WORD_TIMESTAMPS_ENABLED=true
ASR_MIN_AVG_LOGPROB=-1.0
ASR_MAX_NO_SPEECH_PROB=0.6
ASR_MAX_COMPRESSION_RATIO=2.4
M2D_CLAP_MODEL_ID=weights/m2d_clap_vit_base-80x1001p16x16p16kpBpTI-2025/checkpoint-30.pth

# Object detector checkpoint (YOLOE-26, open-vocabulary text-prompt detection)
# Scales: yoloe-26{n,s,m,l,x}-seg.pt - x is the most accurate/slowest
YOLOE_MODEL_ID=yoloe-26x-seg.pt
DETECTION_CONF_THRESHOLD=0.15

# Qdrant configs
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_ALLOW_RECREATE=false
QDRANT_REBUILD_VIDEO_ON_START=false

# Offline upload batching. main.py flushes at every video/process boundary.
QDRANT_UPSERT_BATCH_SIZE=128

# Optional V3C/VBS official assets. Leave V3C_ASSETS_DIR blank to probe the
# dataset directory itself. Expected subdirectories: msb/, keyframes/,
# metadata/, and asr/. Each family independently falls back to local work.
V3C_ASSETS_ENABLED=true
V3C_ASSETS_DIR=
V3C_OFFICIAL_KEYFRAMES_ENABLED=true
# How to read an msb file whose only numeric pair is all integers, where
# seconds and frame numbers are indistinguishable from the file alone. "auto"
# reads it as frames when the video's frame rate is known and refuses the file
# otherwise; "seconds"/"frames" decide explicitly.
V3C_MSB_UNITS=auto

# Shot detector for raw videos. Official V3C msb files still take precedence.
# TransNetV2 weights are downloaded separately; PySceneDetect is the fallback.
SHOT_DETECTOR=transnetv2
SHOT_DETECTOR_FALLBACK=pyscenedetect
SHOT_BENCHMARK_MODE=false
TRANSNETV2_MODEL_PATH=weights/transnetv2-pytorch-weights.pth
TRANSNETV2_DEVICE=auto
TRANSNETV2_BATCH_SIZE=1
TRANSNETV2_THRESHOLD=0.5

# Cheap Laplacian sharpness bonus; set 0 to reproduce semantic-only sampling.
KEYFRAME_SHARPNESS_WEIGHT=0.15

# Index budget vs VLM budget. A frame that was never indexed can never be
# retrieved, so the index keeps as many frames as coverage asks for, while the
# expensive per-frame passes (VLM, SAM3, OCR) stay on the smaller VLM tier.
KEYFRAME_INDEX_MAX_BUDGET=12
KEYFRAME_VLM_MAX_BUDGET=8
# Candidate rate, thinned from the dense decode the Fast pathway already does,
# so raising it costs embedding time rather than extra video decoding.
KEYFRAME_CANDIDATE_FPS=2.0
# Frames are kept until every candidate lies within this cosine distance of a
# kept frame. Lower keeps more; this replaces the old variance thresholds.
KEYFRAME_COVERAGE_TAU=0.12
# DAKE only earns its keep once there is enough to thin.
KEYFRAME_DAKE_MIN_CANDIDATES=8

# Long shots are split so result diversification can surface more than one
# moment from an uncut sequence.
SUBSHOT_SPLIT_ENABLED=true
SUBSHOT_MAX_DURATION_SEC=12.0
SUBSHOT_MIN_DURATION_SEC=3.0

# Region-level index points from the SAM3 crops each described keyframe
# already produces, so small objects and signs are searchable on their own.
REGION_INDEXING_ENABLED=true
REGION_INDEX_MAX_PER_FRAME=4
REGION_INDEX_MIN_AREA_RATIO=0.005
REGION_INDEX_MAX_AREA_RATIO=0.6

# Bump only alongside a deliberate rebuild: point IDs derive from this, so a
# change makes a re-run add a second generation of points rather than replace
# the first. main.py refuses to start when it detects that situation.
INDEX_SCHEMA_VERSION=v2




VLM_MIN_PIXELS=200704
VLM_MAX_PIXELS=602112
