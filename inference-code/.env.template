# OpenAI-compatible API config. Leave OPENAI_BASE_URL blank to use OpenAI
# directly, or point it at any OpenAI-compatible provider (e.g. QwenCloud's
# DashScope endpoint) with a matching OPENAI_VLM_MODEL_NAME
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VLM_MODEL_NAME=gpt-5.5-pro

# Model selection options
VLM_OPTION=openai
# EMBEDDING_OPTION: "local" (QwenVL8BEmbedder, ~15GB) or "cloud"
# (DashScopeCloudEmbedder via OPENAI_API_KEY/OPENAI_BASE_URL, no local weights)
EMBEDDING_OPTION=local

# Model checkpoints
QWEN_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_EMBEDDING_MODEL_ID=Qwen/Qwen2.5-VL-8B-Instruct
M2D_CLAP_MODEL_ID=weights/m2d_clap_vit_base-80x1001p16x16p16kpBpTI-2025/checkpoint-30.pth

# Object detector checkpoint (YOLOE-26, open-vocabulary text-prompt detection)
YOLOE_MODEL_ID=yoloe-26x-seg.pt
DETECTION_CONF_THRESHOLD=0.15

# Qdrant configs
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
